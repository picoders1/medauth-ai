# --- Secrets -----------------------------------------------------------------
# Nothing matching these may ever be committed. The model-provider credential
# lives in the llm-firewall deployment, not here (see docs/security/llm-firewall-integration.md).
.env
.env.*
!.env.example
*.pem
*.key
deploy/secrets/
deploy/certs/

# --- Third-party corpora -----------------------------------------------------
# CMS material is downloaded, never committed (ADR-003). Embedded CPT(R) code
# descriptors are AMA-copyrighted; provenance is recorded in data/cms/registry.yaml,
# which IS committed. The documents themselves are not.
data/cms/**
!data/cms/registry.yaml
!data/cms/.gitkeep

# CMS coverage determinations (NCDs) are downloaded, never committed - same rule as
# data/cms/ and for the same reason (ADR-003). The selection record and the
# provenance registry ARE committed; the documents they describe are not.
data/coverage/documents/**
!data/coverage/ncd_selection.yaml
!data/coverage/registry.yaml

# Synthea output is generated, never committed (ADR-015). The frozen, hashed
# evaluation corpus lives under eval/datasets/ and IS committed.
data/synthea/**
!data/synthea/.gitkeep

# --- Model artefacts ---------------------------------------------------------
# Weights never enter the app tree.
artifacts/
*.onnx
*.safetensors
*.gguf

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# --- Node / Next.js (ui/) ----------------------------------------------------
node_modules/
.next/
out/
.npm/
*.tsbuildinfo

# --- Tooling / OS ------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/

# Reviewer decision payloads carry a named individual's identity and standing. The
# templates are committed; the filled-in payloads are not - the record they produce
# is the artefact, not the input file.
data/review/payloads/*.json
!data/review/payloads/*.template.json

# --- Local assistant / agent tooling -----------------------------------------
# These are local working files, not project artefacts. They were previously kept
# out of commits by .git/info/exclude, which is NOT cloned and NOT shared - so the
# protection existed only on one machine and would have silently lapsed on a fresh
# clone or a re-init. An ignore rule that travels with the repository is the durable
# form of the same intent.
.claude/
CLAUDE.md
.mcp.json
.aider*
