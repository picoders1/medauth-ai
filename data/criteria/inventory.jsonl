{"applicability": "All diagnostic x-ray, laboratory and other diagnostic tests", "authoritative_text": "must be ordered by the physician who is treating the beneficiary", "comparator": null, "criterion_id": "42_CFR_410_32_2026_08_13_C01", "criterion_type": "REQUIRED", "curated_at": "2026-08-23", "curator": "engineering", "curator_role": "non-clinician engineering transcription", "document_sha256": "d87f3242f4328610006b900b2882c2c89c6ea38aa8895fba46842b5d9ac6ee0c", "fact_key": "ordered_by_treating_physician", "normalized_interpretation": "The ordering physician must be the one furnishing a consultation or treating the beneficiary for the specific medical problem.", "ordinal": 1, "policy_id": "42 CFR 410.32", "policy_version": "2026-08-13", "provenance": "authoritative-source; human-transcribed; span-verified", "source_authority": "Office of the Federal Register", "source_chunk_refs": ["42 CFR 410.32:2026-08-13:1", "42 CFR 410.32:2026-08-13:2", "42 CFR 410.32:2026-08-13:3"], "source_page": 1, "source_section": "Ordering diagnostic tests", "source_span": [161, 225], "source_url": "https://www.ecfr.gov/current/title-42/section-410.32", "summary": "Ordered by the physician treating the beneficiary", "threshold": null, "unit": null}
{"applicability": "All diagnostic tests", "authoritative_text": "uses the results in the management of the beneficiary's specific medical problem", "comparator": null, "criterion_id": "42_CFR_410_32_2026_08_13_C02", "criterion_type": "REQUIRED", "curated_at": "2026-08-23", "curator": "engineering", "curator_role": "non-clinician engineering transcription", "document_sha256": "d87f3242f4328610006b900b2882c2c89c6ea38aa8895fba46842b5d9ac6ee0c", "fact_key": "results_used_in_management", "normalized_interpretation": "The test must inform management of the specific problem, not be ordered without a documented use for the result.", "ordinal": 2, "policy_id": "42 CFR 410.32", "policy_version": "2026-08-13", "provenance": "authoritative-source; human-transcribed; span-verified", "source_authority": "Office of the Federal Register", "source_chunk_refs": ["42 CFR 410.32:2026-08-13:1", "42 CFR 410.32:2026-08-13:2", "42 CFR 410.32:2026-08-13:3"], "source_page": 1, "source_section": "Ordering diagnostic tests", "source_span": [342, 422], "source_url": "https://www.ecfr.gov/current/title-42/section-410.32", "summary": "The ordering physician uses the results in managing the problem", "threshold": null, "unit": null}
{"applicability": "Diagnostic tests payable under the physician fee schedule", "authoritative_text": "must be furnished under the appropriate level of supervision", "comparator": null, "criterion_id": "42_CFR_410_32_2026_08_13_C03", "criterion_type": "REQUIRED", "curated_at": "2026-08-23", "curator": "engineering", "curator_role": "non-clinician engineering transcription", "document_sha256": "d87f3242f4328610006b900b2882c2c89c6ea38aa8895fba46842b5d9ac6ee0c", "fact_key": "appropriate_supervision_level", "normalized_interpretation": "General, direct or personal supervision as designated for the test. Services furnished without it are not reasonable and necessary.", "ordinal": 3, "policy_id": "42 CFR 410.32", "policy_version": "2026-08-13", "provenance": "authoritative-source; human-transcribed; span-verified", "source_authority": "Office of the Federal Register", "source_chunk_refs": ["42 CFR 410.32:2026-08-13:4", "42 CFR 410.32:2026-08-13:5", "42 CFR 410.32:2026-08-13:6"], "source_page": 1, "source_section": "Paragraph (b)", "source_span": [259, 319], "source_url": "https://www.ecfr.gov/current/title-42/section-410.32", "summary": "Furnished under the appropriate level of physician supervision", "threshold": null, "unit": null}
