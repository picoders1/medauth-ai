# MEDAUTH AI — example configuration
#
# Copy to .env and fill in. `.env` is gitignored; this file must contain
# PLACEHOLDERS ONLY. A real credential committed here is a security incident.
#
# Two deliberately separate configuration systems (ADR-017):
#   settings  — this file / environment, prefix MEDAUTH_ ......... secrets + deployment values
#   policy    — config/decision-policy.yaml ...................... thresholds, actions, gates
#
# Secrets never appear in policy YAML; keys matching *_key / *secret* / *token*
# / *password* are structurally rejected at policy load time.

# --- Environment -------------------------------------------------------------
# development | production. `production` enforces the security boundaries and
# refuses to start if any of them are disabled.
MEDAUTH_ENVIRONMENT=development

# --- Model access (via LLM Firewall) -----------------------------------------
# MEDAUTH speaks the OpenAI HTTP contract and points at the firewall, never at a
# provider. The provider credential is held by the FIREWALL, not by MEDAUTH:
#
#   MEDAUTH ──(caller key)──▶ llm-firewall :8005/v1 ──(provider key)──▶ provider
#
# Consequence: MEDAUTH holds no model-provider credential at all. See
# docs/security/llm-firewall-integration.md and ADR-016.
#
# THE VALUES BELOW ARE PLACEHOLDERS. The real provider host and model id are
# deployment values: they belong in .env (gitignored) and in the firewall's own
# environment. Neither appears anywhere in this repository.
MEDAUTH_LLM_BASE_URL=http://localhost:8005/v1
MEDAUTH_LLM_MODEL=example-model-v1
# The model serving structured-output roles. On this deployment it is NOT the same
# model as MEDAUTH_LLM_MODEL: the capability probe found they support inverted
# structured-output modes. Leave empty only where one model does both.
MEDAUTH_LLM_STRUCTURED_MODEL=example-structured-model-v1

# Firewall CALLER key (not a provider key). Mint with the firewall's
# `scripts/generate_caller_key.py medauth-ai`; that prints a raw key (goes here)
# and a SHA-256 digest (goes in the firewall's FIREWALL_CALLER_API_KEYS).
MEDAUTH_LLM_API_KEY=replace-me-with-firewall-caller-key

# Fail-closed behaviour. A firewall 403 (blocked) or 503 (detector failure) must
# never be retried into an approval; the case routes to HUMAN_REVIEW. Turning
# this off is refused in production.
MEDAUTH_LLM_FAIL_CLOSED=true
MEDAUTH_LLM_TIMEOUT_SECONDS=60
MEDAUTH_LLM_MAX_ATTEMPTS=3

# Streaming is refused by the firewall (400 unsupported_feature) and is not used
# here — every model call returns a schema-validated object. Present as a guard.
MEDAUTH_LLM_STREAMING_ENABLED=false

# --- Database ----------------------------------------------------------------
# PostgreSQL 16 + pgvector. Host port 5435 (5432/5433/5434 are occupied on the
# reference machine — see docs/architecture/repository-structure.md).
MEDAUTH_DATABASE_URL=postgresql+asyncpg://medauth:medauth@localhost:5435/medauth
MEDAUTH_DATABASE_COMMAND_TIMEOUT_SECONDS=5

# --- Retrieval (local, does NOT traverse the firewall) -----------------------
# The firewall exposes no /v1/embeddings, and embedding a policy corpus through a
# security gateway would inspect nothing useful. These run in-process.
MEDAUTH_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
MEDAUTH_RERANKER_MODEL=BAAI/bge-reranker-base
MEDAUTH_EMBEDDING_DEVICE=cpu
MEDAUTH_RETRIEVAL_TOP_K=40
MEDAUTH_RERANK_TOP_N=8

# --- Audit -------------------------------------------------------------------
# The audit trail is append-only; there is no UPDATE or DELETE path in the
# application (ADR-013). Retention deletes by age and by nothing else.
MEDAUTH_AUDIT_REQUIRED=true
MEDAUTH_RETENTION_ENABLED=false
MEDAUTH_RETENTION_DAYS=180

# --- Observability -----------------------------------------------------------
# OTel + Prometheus is the always-on baseline. Langfuse is an opt-in compose
# overlay (ADR-018) — self-hosted v3 needs ClickHouse + Redis + object storage
# and is too heavy to require for a normal run.
MEDAUTH_OTEL_ENABLED=false
MEDAUTH_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
MEDAUTH_METRICS_ENABLED=true

# Clinical text is never logged. Enforced at the structlog sink, not per call
# site; `full` is refused in production, in code.
MEDAUTH_CLINICAL_TEXT_LOGGING=off

# LANGFUSE_* are read only when the overlay is running.
# LANGFUSE_HOST=http://localhost:3200
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- API / UI ----------------------------------------------------------------
# The port the API binds INSIDE its container - not the port you reach it on.
# compose.yaml publishes it to the host as 8015 (`8015:8010`), so use
# http://localhost:8015 from the host and leave this at 8010 (ADR-019 amendment).
MEDAUTH_API_PORT=8010
MEDAUTH_UI_ORIGIN=http://localhost:3100

# Reviewer identity is derived from a trusted proxy, never read from an
# untrusted client. `0.0.0.0/0` is refused at startup (ADR-012).
MEDAUTH_TRUSTED_PROXIES=127.0.0.1/32

# --- Caller (SERVICE) authentication -----------------------------------------
# Which integrating SYSTEM is calling. Never a person. Format: key:caller-id,...
# Empty means the API authenticates nobody and therefore serves nobody: an
# unconfigured deployment fails closed rather than admitting everyone.
MEDAUTH_API_KEYS=replace-with-a-generated-key:example-integrator

# --- Reviewer (HUMAN) authentication -----------------------------------------
# A SERVICE key can never review, override or finalise. Those are human-only
# actions, refused to a service principal before its permissions are even read.
#
#   development  a configured principal table. REFUSED in production.
#   oidc         a validated bearer token from an identity provider.
MEDAUTH_AUTH_MODE=development

# Development only. Format: token:principal-id:role,...
# Roles: medauth-readonly | medauth-reviewer | medauth-senior-reviewer
MEDAUTH_DEV_REVIEWERS=replace-with-a-local-token:dr-example:medauth-reviewer

# --- OIDC (production) -------------------------------------------------------
# NO identity provider is named by this project. Any conformant OIDC provider
# works: configure an issuer, and `jwks_uri` is read from that issuer's own
# .well-known/openid-configuration document. Nothing vendor-specific goes here.
MEDAUTH_OIDC_ISSUER=https://replace-with-your-issuer/realms/example
MEDAUTH_OIDC_AUDIENCE=replace-with-your-client-or-audience
MEDAUTH_OIDC_DISCOVERY=true

# Set ONLY to pin a key endpoint when discovery is unavailable. Leave blank
# otherwise - discovery ties the key source to the issuer, and a hand-configured
# jwks_uri does not.
MEDAUTH_OIDC_JWKS_URL=

# HS256 symmetric verification. TESTS ONLY, and production refuses to start with
# it set: the verifier holds the key that signs, so anyone holding this file
# could mint a reviewer token - and the audit trail would record it as a
# verified human identity.
MEDAUTH_OIDC_SECRET=
